# Copy to .env and fill in. .env is git-ignored — never commit real keys.

# --- Local development ------------------------------------------------------
WP_PORT=8080
ADMINER_PORT=8081
MAILPIT_PORT=8025
# Mail-stall testing only: point mail at a blackhole (e.g. 10.255.255.1:1025)
# to reproduce a hanging mail host; empty routes to Mailpit. DEV_SMTP_TIMEOUT
# raises the 10s dev timeout when the stall itself is what you are measuring.
DEV_SMTP=
DEV_SMTP_TIMEOUT=
DB_NAME=scholaris
DB_USER=scholaris
DB_PASSWORD=scholaris
DB_ROOT_PASSWORD=root
WP_DEBUG=1

# --- Site bootstrap (used by scripts/setup.sh) ------------------------------
SITE_URL=http://localhost:8080
SITE_TITLE=Scholaris
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now
ADMIN_EMAIL=you@example.com

# --- Assistant API key ------------------------------------------------------
# The key lives here, on the server, and nowhere else: there is no field in
# the settings screen and no prompt in the chat window, by design. One
# provider is enough — the assistant runs on whichever has a key (set
# several to switch in Settings → EduAI Assistant).
# Groq (free tier):      https://console.groq.com/keys
# Z.ai GLM (free tier):  https://z.ai/manage-apikey/apikey-list
# Anthropic (Claude):    https://console.anthropic.com/settings/keys
GROQ_API_KEY=
ZAI_API_KEY=
ANTHROPIC_API_KEY=
